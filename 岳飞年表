<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>岳飞生平完整时间轴 | 附诗词链接</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "SimSun", "宋体", serif;
            line-height: 1.6;
            color: #333;
            background-color: #f8f5f0;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 3px solid #8b0000;
        }
        
        h1 {
            font-size: 2.8rem;
            color: #8b0000;
            margin-bottom: 10px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }
        
        .subtitle {
            font-size: 1.2rem;
            color: #666;
            font-style: italic;
        }
        
        .timeline {
            position: relative;
            padding: 40px 0;
        }
        
        /* 时间轴中心线 */
        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 6px;
            background-color: #8b0000;
            transform: translateX(-50%);
            border-radius: 3px;
        }
        
        /* 时间轴节点 */
        .timeline-item {
            display: flex;
            margin-bottom: 50px;
            position: relative;
        }
        
        /* 左侧时间节点 */
        .timeline-item:nth-child(odd) {
            flex-direction: row;
        }
        
        /* 右侧时间节点 */
        .timeline-item:nth-child(even) {
            flex-direction: row-reverse;
        }
        
        /* 时间点内容 */
        .timeline-content {
            width: 45%;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            position: relative;
            border-left: 5px solid #8b0000;
        }
        
        /* 左侧节点箭头 */
        .timeline-item:nth-child(odd) .timeline-content::after {
            content: '';
            position: absolute;
            right: -15px;
            top: 25px;
            width: 0;
            height: 0;
            border-top: 15px solid transparent;
            border-bottom: 15px solid transparent;
            border-left: 15px solid white;
        }
        
        /* 右侧节点箭头 */
        .timeline-item:nth-child(even) .timeline-content::after {
            content: '';
            position: absolute;
            left: -15px;
            top: 25px;
            width: 0;
            height: 0;
            border-top: 15px solid transparent;
            border-bottom: 15px solid transparent;
            border-right: 15px solid white;
        }
        
        /* 时间点圆圈标记 */
        .timeline-marker {
            position: absolute;
            left: 50%;
            top: 20px;
            width: 20px;
            height: 20px;
            background-color: #8b0000;
            border: 4px solid #f8f5f0;
            border-radius: 50%;
            transform: translateX(-50%);
            z-index: 1;
        }
        
        /* 年份样式 */
        .year {
            font-size: 1.6rem;
            font-weight: bold;
            color: #8b0000;
            margin-bottom: 5px;
        }
        
        /* 年龄/时期样式 */
        .age {
            font-size: 1rem;
            color: #666;
            font-weight: bold;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px dashed #ddd;
        }
        
        /* 事件描述 */
        .events {
            font-size: 1rem;
        }
        
        .events ul {
            padding-left: 20px;
        }
        
        .events li {
            margin-bottom: 6px;
        }
        
        /* 历史时期标记 */
        .period {
            display: inline-block;
            background-color: #F5F0E6;
            color: #8B7355;
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 0.85rem;
            margin-bottom: 8px;
            font-weight: bold;
        }
        
        /* 诗词链接区域 */
        .poem-links {
            margin-top: 60px;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-left: 5px solid #2e5a2e;
        }
        
        .poem-links h2 {
            color: #2e5a2e;
            text-align: center;
            margin-bottom: 25px;
            font-size: 2rem;
            padding-bottom: 10px;
            border-bottom: 2px solid #e0e0e0;
        }
        
        .poem-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .poem-card {
            background-color: #f9f7f3;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-left: 4px solid #8B7355;
        }
        
        .poem-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }
        
        .poem-card h3 {
            color: #2e5a2e;
            margin-bottom: 10px;
            font-size: 1.3rem;
        }
        
        .poem-card p {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 15px;
            line-height: 1.5;
        }
        
        .poem-link {
            display: inline-block;
            background-color: #8b0000;
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 4px;
            font-size: 0.9rem;
            transition: background-color 0.3s ease;
        }
        
        .poem-link:hover {
            background-color: #a00;
        }
        
        /* 响应式设计 */
        @media (max-width: 768px) {
            .timeline::before {
                left: 20px;
            }
            
            .timeline-item {
                flex-direction: row !important;
                margin-left: 40px;
            }
            
            .timeline-content {
                width: 100%;
            }
            
            .timeline-marker {
                left: 20px;
            }
            
            .timeline-item:nth-child(odd) .timeline-content::after,
            .timeline-item:nth-child(even) .timeline-content::after {
                left: -15px;
                right: auto;
                border-right: 15px solid white;
                border-left: none;
            }
            
            .poem-grid {
                grid-template-columns: 1fr;
            }
            
            h1 {
                font-size: 2.2rem;
            }
        }
        
        footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            color: #666;
            font-size: 0.9rem;
        }
        
        /* 特殊标记 */
        .important {
            color: #b22222;
            font-weight: bold;
        }
        
        /* 时间轴节点悬停效果 */
        .timeline-content:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
    </style>
</head>
